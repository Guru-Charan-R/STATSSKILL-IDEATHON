PORT=4000

# Groq API key — backend only. Never put this in frontend/Vercel env vars.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173

# Optional: where the SQLite file is stored.
# DB_PATH=/absolute/path/to/statskill.db
